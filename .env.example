# Skopiuj ten plik do .env i uzupełnij prawdziwymi danymi.
# .env NIGDY nie powinien trafić do repozytorium / gita.

# --- Przelewy24 ---------------------------------------------------
# Dane znajdziesz w panelu Przelewy24: "Moje dane" -> "Dane API i konfiguracja".
# Dla konta produkcyjnego i sandboxa dane są RÓŻNE — używaj właściwego kompletu.
P24_MERCHANT_ID=000000
P24_POS_ID=000000
# "Klucz do raportów" (czasem nazywany kluczem API / secretId) — hasło do Basic Auth.
P24_API_KEY=twoj-klucz-api-z-panelu
# Klucz CRC — używany wyłącznie do liczenia sumy kontrolnej (sign).
P24_CRC=twoj-klucz-crc-z-panelu
# true = środowisko testowe sandbox.przelewy24.pl, false = produkcja secure.przelewy24.pl
P24_SANDBOX=true

# --- Adresy publiczne -------------------------------------------------
# Jeśli strona (frontend) i ten backend stoją na TYM SAMYM hoście — ustaw tylko
# PUBLIC_URL, reszta się z niego wyliczy. Jeśli hosting statycznej strony (np. GoDaddy
# shared hosting bez Node.js) jest INNY niż hosting backendu (np. Render/Railway/VPS),
# ustaw SITE_URL i API_URL osobno — patrz też zamowienie.html i podziekowanie.html
# (zmienna API_BASE na górze <script>, musi wskazywać na to samo co API_URL tutaj).
PUBLIC_URL=http://localhost:3000
# SITE_URL=https://lecimyposwoje.pl
# API_URL=https://lecimyposwoje-api.onrender.com

PORT=3000

# --- Wysyłka e-maila z dostępem do kursu ----------------------------
# Dowolny serwer SMTP: skrzynka firmowa, Gmail (hasło aplikacji), albo usługa
# transakcyjna typu Resend / SendGrid / Mailgun (zwykle prostsze i pewniejsze niż zwykły SMTP).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=kontakt@lecimyposwoje.pl
SMTP_PASS=haslo-lub-klucz-api
SMTP_FROM=Lecimy po swoje <kontakt@lecimyposwoje.pl>
